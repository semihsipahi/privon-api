# === PRODUCTION ENVIRONMENT ===
NODE_ENV=production
PORT=8080

# === Database ===
# Use MongoDB Atlas or managed MongoDB service
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/privon?retryWrites=true&w=majority

# === JWT Authentication ===
# IMPORTANT: Use strong, randomly generated secrets (min 64 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET_KEY=your-strong-production-jwt-secret-key-min-64-chars-required
JWT_EXPIRES_IN=24h
REFRESH_JWT_SECRET_KEY=your-strong-production-refresh-secret-key-min-64-chars-required
REFRESH_JWT_EXPIRES_IN=30d

# === SMS (VatanSMS - Turkish SMS provider) ===
# For international: replace with Twilio, AWS SNS, or local provider
SMSUSER=production-sms-account-username
SMSPASSWORD=production-sms-account-password
SMS_HEADER=PRIVON

# === Email (Sendgrid, AWS SES, or similar managed service) ===
# Gmail not recommended for production (rate limits, security risks)
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USER=apikey
MAIL_PASS=SG.your-sendgrid-api-key-here
MAIL_FROM=noreply@privon.com

# === File Upload (AWS S3 for production) ===
# MinIO can be used for self-hosted option, but AWS S3 is recommended for reliability
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=AKIA...your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=privon-production
# OR use MinIO if self-hosted:
# MINIO_ENDPOINT=minio.privon.com
# MINIO_ACCESS_KEY=production-access-key
# MINIO_SECRET_KEY=production-secret-key
# MINIO_BUCKET=privon

# === Frontend URLs ===
BASE_URL_FRONT=https://privon.com
BASE_URL_APP=https://app.privon.com

# === Logging ===
LOG_LEVEL=warn

# === Security ===
# Enable HTTPS, set CORS origins, enforce rate limiting
CORS_ORIGINS=https://privon.com,https://app.privon.com,https://admin.privon.com

# === Optional: OneSignal (Push Notifications) ===
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key

# === Optional: Analytics/Monitoring ===
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
DATADOG_API_KEY=your-datadog-api-key
