              ],
              "path": [
                "v1",
                "venues",
                "{{slug}}",
                "checkout",
                "confirm"
              ]
            },
            "description": "responseMode parametresi YOK. Tam yanit.\nScenario A (ucretsiz): {id, code, status}\nScenario B/D (odeme): {status: PAYMENT_REQUIRED, paymentType, paymentInfo}"
          }
        },
        {
          "name": "6b. Confirm - WITH responseMode=v1 (slim yanit)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
