              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"model\": {\n    \"client\": {\n      \"firstName\": \"Test\",\n      \"lastName\": \"Kullanici\",\n      \"phoneNumberCountryCode\": \"90\",\n      \"phoneNumber\": \"5001234567\",\n      \"emailAddress\": \"test@privon.com\"\n    },\n    \"femaleCount\": 0,\n    \"note\": \"Postman test\",\n    \"hasCakeDelivery\": false,\n    \"hasFlowerDelivery\": false,\n    \"needInvoice\": false\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{rezervemBaseUrl}}/v1/venues/{{slug}}/checkout/confirm?responseMode=v1",
              "host": [
