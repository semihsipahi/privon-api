    {
      "name": "5. Reservations",
      "item": [
        {
          "name": "List Reservations - saves reservationId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "const items = res.items ?? [];",
                  "console.log('HTTP status:', pm.response.code);",
                  "console.log('totalCount:', res.totalCount, '| page:', res.page, '| pageSize:', res.pageSize);",
                  "if (items.length > 0) {",
                  "  const first = items[0];",
                  "  const rid = first.reservationId ?? first.id;",
                  "  pm.collectionVariables.set('reservationId', String(rid));",
                  "  console.log('reservationId saved:', rid);",
                  "  console.log('First: slug=' + first.slug + ' status=' + first.status + ' date=' + first.date + ' guest=' + first.guestName);",
                  "} else {",
                  "  console.warn('No reservations found');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{rezervemToken}}"
              }
            ],
            "url": {
              "raw": "{{rezervemBaseUrl}}/v1/reservations?page=1&pageSize=20",
              "host": [
                "{{rezervemBaseUrl}}"
              ],
              "path": [
                "v1",
                "reservations"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "20"
                },
                {
                  "key": "date",
                  "value": "",
                  "description": "Tarih filtresi yyyy-MM-dd. Aktif etmek icin disable kaldir.",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "",
                  "description": "Durum filtresi. Aktif etmek icin disable kaldir.",
                  "disabled": true
                }
              ]
            },
            "description": "Partner'a ait tum rezervasyonlari listeler.\n\nParametreler:\n- date: yyyy-MM-dd (optional)\n- status: Confirmed | Cancelled | Pending vb. (optional)\n- page / pageSize: sayfalama\n\nIlk reservationId otomatik {{reservationId}}'ye kaydedilir.\n\nNot: POS partner telefon/email tam goriinur. GuestNetwork maskelenmis."
          }
        },
        {
          "name": "List Reservations - by DATE",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{rezervemToken}}"
              }
            ],
            "url": {
              "raw": "{{rezervemBaseUrl}}/v1/reservations?date={{date}}&page=1&pageSize=50",
              "host": [
                "{{rezervemBaseUrl}}"
              ],
              "path": [
                "v1",
                "reservations"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "{{date}}"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "50"
                }
              ]
            },
            "description": "Belirli bir gune ait tum rezervasyonlar. {{date}} collection variable kullanilir (yyyy-MM-dd).\n\nOrnek: date = 2026-06-15"
          }
        },
        {
          "name": "List Reservations - by STATUS",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{rezervemToken}}"
              }
            ],
            "url": {
              "raw": "{{rezervemBaseUrl}}/v1/reservations?status=Confirmed&page=1&pageSize=50",
              "host": [
                "{{rezervemBaseUrl}}"
              ],
              "path": [
                "v1",
                "reservations"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "Confirmed"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "50"
                }
              ]
            },
            "description": "Belirli durumdaki rezervasyonlar. status degerini degistirin:\nConfirmed | Cancelled | Pending | Rejected"
          }
        },
