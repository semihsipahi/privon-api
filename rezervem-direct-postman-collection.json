{
  "info": {
    "name": "Rezervem Partner API — Direct",
    "description": "Rezervem Partner API'sine doğrudan erişim. Privon API proxy olmadan ham yanıtları karşılaştırmak için kullanın.\n\nAkış: Token Al → Mekanlar → Bootstrap → Tarihler → Saatler → Alanlar → Hold → Confirm (x2) → Finalize",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "rezervemBaseUrl", "value": "https://partnerapi.rezervem.com.tr", "type": "string" },
    { "key": "rezervemToken",   "value": "", "type": "string" },
    { "key": "clientId",        "value": "", "type": "string", "description": "REZERVEM_CLIENT_ID (.env)" },
    { "key": "clientSecret",    "value": "", "type": "string", "description": "REZERVEM_CLIENT_SECRET (.env)" },
    { "key": "slug",            "value": "", "type": "string" },
    { "key": "sessionId",       "value": "", "type": "string" },
    { "key": "pax",             "value": "2", "type": "string" },
    { "key": "date",            "value": "", "type": "string", "description": "YYYY-MM-DD" },
    { "key": "time",            "value": "", "type": "string", "description": "HH:mm" },
    { "key": "shift",           "value": "2", "type": "string", "description": "0=Kahvalti 1=Ogle 2=Aksam 3=Bar" },
    { "key": "roomId",          "value": "", "type": "string", "description": "areas[].id — alan gerektiren mekanlarda zorunlu" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Get Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.accessToken) {",
                  "  pm.collectionVariables.set('rezervemToken', res.accessToken);",
                  "  console.log('[Rezervem] Token saved. Expires in:', res.expiresIn, 's');",
                  "} else {",
                  "  console.error('[Rezervem] Token missing in response:', JSON.stringify(res));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"GrantType\": \"client_credentials\",\n  \"ClientId\": \"{{clientId}}\",\n  \"ClientSecret\": \"{{clientSecret}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{rezervemBaseUrl}}/connect/token",
              "host": ["{{rezervemBaseUrl}}"],
              "path": ["connect", "token"]
            },
            "description": "OAuth2 token alır. Basarili olursa {{rezervemToken}} otomatik set edilir.\n\nclientId ve clientSecret'i collection Variables'tan girin (.env dosyasindaki REZERVEM_CLIENT_ID / REZERVEM_CLIENT_SECRET)."
          }
        }
      ]
    },
    {
      "name": "2. Venues",
      "item": [
        {
          "name": "List Venues — saves slug",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "const items = res.items ?? res;",
                  "if (Array.isArray(items) && items.length > 0) {",
                  "  pm.collectionVariables.set('slug', items[0].slug);",
                  "  console.log('[Rezervem] slug saved:', items[0].slug);",
                  "  console.log('[Rezervem] All slugs:', items.map(v => v.slug).join(', '));",
                  "} else {",
                  "  console.warn('[Rezervem] No venues found');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{rezervemToken}}" }
            ],
            "url": {
              "raw": "{{rezervemBaseUrl}}/v1/venues?page=1&pageSize=50",
              "host": ["{{rezervemBaseUrl}}"],
              "path": ["v1", "venues"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "50" }
              ]
            },
            "description": "Tum mekan listesi. items[0].slug otomatik olarak {{slug}}'a kaydedilir."
          }
        }
      ]
    },
    {
      "name": "3. Booking Flow",
      "item": [
        {
          "name": "1. Bootstrap",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{rezervemToken}}" }
            ],
            "url": {
              "raw": "{{rezervemBaseUrl}}/v1/venues/{{slug}}/bootstrap",
              "host": ["{{rezervemBaseUrl}}"],
              "path": ["v1", "venues", "{{slug}}", "bootstrap"]
            },
            "description": "Mekanin rezervasyon akisi yapilandirmasi. pax min/max, bookingFlow adimlari, odeme politikalari, alan listesi."
          }
        },
        {
          "name": "2. Available Dates",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{rezervemToken}}" }
            ],
            "url": {
              "raw": "{{rezervemBaseUrl}}/v1/venues/{{slug}}/availability/dates?partySize={{pax}}",
              "host": ["{{rezervemBaseUrl}}"],
              "path": ["v1", "venues", "{{slug}}", "availability", "dates"],
              "query": [
                { "key": "partySize", "value": "{{pax}}" }
              ]
            },
            "description": "Musait tarihleri getirir. dates[].status: AVAILABLE | LIMITED | FULL"
          }
        },
        {
          "name": "3. Available Times",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{rezervemToken}}" }
            ],
            "url": {
              "raw": "{{rezervemBaseUrl}}/v1/venues/{{slug}}/availability/times?partySize={{pax}}&date={{date}}",
              "host": ["{{rezervemBaseUrl}}"],
              "path": ["v1", "venues", "{{slug}}", "availability", "times"],
              "query": [
                { "key": "partySize", "value": "{{pax}}" },
                { "key": "date",      "value": "{{date}}" }
              ]
            },
            "description": "Secilen tarihteki musait saatler. shifts[].times[].status: AVAILABLE | LIMITED | FULL"
          }
        },
        {
          "name": "4. Available Areas — saves roomId",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "const areas = res.areas ?? res.rooms ?? (Array.isArray(res) ? res : []);",
                  "if (areas.length > 0) {",
                  "  const first = areas[0];",
                  "  pm.collectionVariables.set('roomId', String(first.id));",
                  "  console.log('[Rezervem] roomId saved:', first.id, '| name:', first.title?.tr ?? first.title ?? first.name);",
                  "  console.log('[Rezervem] All areas:', areas.map(a => a.id + ':' + (a.title?.tr ?? a.title ?? a.name)).join(', '));",
                  "} else {",
                  "  console.log('[Rezervem] No areas — this venue does not require area selection');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{rezervemToken}}" }
            ],
            "url": {
              "raw": "{{rezervemBaseUrl}}/v1/venues/{{slug}}/availability/areas?partySize={{pax}}&date={{date}}&time={{time}}&shift={{shift}}",
              "host": ["{{rezervemBaseUrl}}"],
              "path": ["v1", "venues", "{{slug}}", "availability", "areas"],
              "query": [
                { "key": "partySize", "value": "{{pax}}" },
                { "key": "date",      "value": "{{date}}" },
                { "key": "time",      "value": "{{time}}" },
                { "key": "shift",     "value": "{{shift}}" }
              ]
            },
            "description": "Secilen tarih ve saatteki musait alanlar/odalar. areas[].selectable: true/false"
          }
        },
        {
          "name": "5. Hold Slot — saves sessionId",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "const sid = res.sessionId ?? res.result?.sessionId;",
                  "if (sid) {",
                  "  pm.collectionVariables.set('sessionId', sid);",
                  "  console.log('[Rezervem] sessionId saved:', sid);",
                  "  console.log('[Rezervem] hold status:', res.status, '| expiresOn:', res.expiresOn);",
                  "} else {",
                  "  console.warn('[Rezervem] No sessionId in hold response. status:', res.status);",
                  "  console.warn('[Rezervem] Full response:', JSON.stringify(res));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{rezervemToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"{{date}}\",\n  \"time\": \"{{time}}\",\n  \"pax\": {{pax}},\n  \"shift\": {{shift}},\n  \"roomId\": {{roomId}},\n  \"paymentMode\": \"immediate\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{rezervemBaseUrl}}/v1/venues/{{slug}}/checkout/hold",
              "host": ["{{rezervemBaseUrl}}"],
              "path": ["v1", "venues", "{{slug}}", "checkout", "hold"]
            },
            "description": "Slotu gecici olarak rezerve eder. Basarili olursa sessionId otomatik kaydedilir.\n\nroomId: alan secildiyse ekle. paymentMode: immediate | deferred"
          }
        },
        {
          "name": "6a. Confirm — WITHOUT responseMode (ham yanit)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{rezervemToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"model\": {\n    \"client\": {\n      \"firstName\": \"Test\",\n      \"lastName\": \"Kullanici\",\n      \"phoneNumberCountryCode\": \"90\",\n      \"phoneNumber\": \"5001234567\",\n      \"emailAddress\": \"test@privon.com\"\n    },\n    \"femaleCount\": 0,\n    \"note\": \"Postman test\",\n    \"hasCakeDelivery\": false,\n    \"hasFlowerDelivery\": false,\n    \"needInvoice\": false\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{rezervemBaseUrl}}/v1/venues/{{slug}}/checkout/confirm",
              "host": ["{{rezervemBaseUrl}}"],
              "path": ["v1", "venues", "{{slug}}", "checkout", "confirm"]
            },
            "description": "responseMode parametresi YOK — tam (full) yanit. PAYMENT_REQUIRED durumunda paymentUrl/paymentInfo icerigi burada gorunur.\n\nScenario A (ucretsiz): {id, code, status, ...}\nScenario B/D (odeme): {status:PAYMENT_REQUIRED, paymentType, paymentInfo, ...}"
          }
        },
        {
          "name": "6b. Confirm — WITH responseMode=v1 (slim yanit)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{rezervemToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"model\": {\n    \"client\": {\n      \"firstName\": \"Test\",\n      \"lastName\": \"Kullanici\",\n      \"phoneNumberCountryCode\": \"90\",\n      \"phoneNumber\": \"5001234567\",\n      \"emailAddress\": \"test@privon.com\"\n    },\n    \"femaleCount\": 0,\n    \"note\": \"Postman test\",\n    \"hasCakeDelivery\": false,\n    \"hasFlowerDelivery\": false,\n    \"needInvoice\": false\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{rezervemBaseUrl}}/v1/venues/{{slug}}/checkout/confirm?responseMode=v1",
              "host": ["{{rezervemBaseUrl}}"],
              "path": ["v1", "venues", "{{slug}}", "checkout", "confirm"],
              "query": [
                { "key": "responseMode", "value": "v1" }
              ]
            },
            "description": "responseMode=v1 VAR — slim yanit. Privon API'nin simdi kullandigi mod.\n\n6a vs 6b'yi karsilastirarak responseMode'un PAYMENT_REQUIRED yanitini degistirip degistirmedigini gorebilirsiniz."
          }
        },
        {
          "name": "7. Finalize (3DS / Provision sonrasi)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{rezervemToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"paymentCompleted\": true,\n  \"model\": {\n    \"client\": {\n      \"firstName\": \"Test\",\n      \"lastName\": \"Kullanici\",\n      \"phoneNumberCountryCode\": \"90\",\n      \"phoneNumber\": \"5001234567\",\n      \"emailAddress\": \"test@privon.com\"\n    },\n    \"femaleCount\": 0,\n    \"note\": \"Postman test\",\n    \"hasCakeDelivery\": false,\n    \"hasFlowerDelivery\": false,\n    \"needInvoice\": false\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{rezervemBaseUrl}}/v1/venues/{{slug}}/checkout/finalize",
              "host": ["{{rezervemBaseUrl}}"],
              "path": ["v1", "venues", "{{slug}}", "checkout", "finalize"]
            },
            "description": "3D-Secure veya Provision odemesi tamamlandiktan sonra cagrilir. paymentCompleted: true/false"
          }
        }
      ]
    },
    {
      "name": "4. Utilities",
      "item": [
        {
          "name": "Get Venue Detail",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{rezervemToken}}" }
            ],
            "url": {
              "raw": "{{rezervemBaseUrl}}/v1/venues/{{slug}}",
              "host": ["{{rezervemBaseUrl}}"],
              "path": ["v1", "venues", "{{slug}}"]
            },
            "description": "Tek mekan detayi."
          }
        },
        {
          "name": "Get Session Status",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{rezervemToken}}" }
            ],
            "url": {
              "raw": "{{rezervemBaseUrl}}/v1/venues/{{slug}}/checkout/{{sessionId}}",
              "host": ["{{rezervemBaseUrl}}"],
              "path": ["v1", "venues", "{{slug}}", "checkout", "{{sessionId}}"]
            },
            "description": "Mevcut checkout oturumunun durumunu sorgular."
          }
        }
      ]
    }
  ]
}
