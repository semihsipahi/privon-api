          }
        },
        {
          "name": "5. Hold Slot - saves sessionId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "const sid = res.sessionId ?? res.result?.sessionId;",
                  "if (sid) {",
                  "  pm.collectionVariables.set('sessionId', sid);",
                  "  console.log('sessionId saved:', sid);",
                  "  console.log('hold status:', res.status, '| expiresOn:', res.expiresOn);",
                  "} else {",
                  "  console.warn('No sessionId. status:', res.status);",
                  "  console.warn('Full response:', JSON.stringify(res));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{rezervemToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"{{date}}\",\n  \"time\": \"{{time}}\",\n  \"pax\": {{pax}},\n  \"shift\": {{shift}},\n  \"roomId\": {{roomId}},\n  \"paymentMode\": \"immediate\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{rezervemBaseUrl}}/v1/venues/{{slug}}/checkout/hold",
              "host": [
                "{{rezervemBaseUrl}}"
              ],
              "path": [
                "v1",
                "venues",
                "{{slug}}",
                "checkout",
                "hold"
              ]
            },
            "description": "Slotu gecici olarak rezerve eder. Basarili olursa sessionId otomatik kaydedilir.\n\nroomId: alan secildiyse ekle. paymentMode: immediate | deferred"
          }
        },
        {
          "name": "6a. Confirm - WITHOUT responseMode (ham yanit)",
