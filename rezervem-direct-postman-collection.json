  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Get Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.accessToken) {",
                  "  pm.collectionVariables.set('rezervemToken', res.accessToken);",
                  "  console.log('Token saved. Expires in:', res.expiresIn, 's');",
                  "} else {",
                  "  console.error('Token missing:', JSON.stringify(res));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"GrantType\": \"client_credentials\",\n  \"ClientId\": \"{{clientId}}\",\n  \"ClientSecret\": \"{{clientSecret}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{rezervemBaseUrl}}/connect/token",
              "host": [
                "{{rezervemBaseUrl}}"
              ],
              "path": [
                "connect",
                "token"
              ]
            },
            "description": "OAuth2 token alir. Basarili olursa {{rezervemToken}} otomatik set edilir.\n\nclientId ve clientSecret degerlerini Collection Variables'tan girin (.env dosyasindaki REZERVEM_CLIENT_ID / REZERVEM_CLIENT_SECRET)."
          }
        }
      ]
    },
    {
      "name": "2. Venues",
      "item": [
        {
          "name": "List Venues - saves slug",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "const items = res.items ?? res;",
                  "if (Array.isArray(items) && items.length > 0) {",
                  "  pm.collectionVariables.set('slug', items[0].slug);",
                  "  console.log('slug saved:', items[0].slug);",
                  "  console.log('All slugs:', items.map(v => v.slug).join(', '));",
                  "} else {",
                  "  console.warn('No venues found');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{rezervemToken}}"
              }
            ],
            "url": {
              "raw": "{{rezervemBaseUrl}}/v1/venues?page=1&pageSize=50",
              "host": [
                "{{rezervemBaseUrl}}"
              ],
              "path": [
                "v1",
                "venues"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "50"
                }
              ]
            },
            "description": "Tum mekan listesi. items[0].slug otomatik olarak {{slug}}'a kaydedilir."
          }
        }
      ]
    },
