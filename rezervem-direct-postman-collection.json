        {
          "name": "4. Available Areas - saves roomId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "const areas = res.areas ?? res.rooms ?? (Array.isArray(res) ? res : []);",
                  "if (areas.length > 0) {",
                  "  const first = areas[0];",
                  "  pm.collectionVariables.set('roomId', String(first.id));",
                  "  console.log('roomId saved:', first.id, '| name:', first.title?.tr ?? first.title ?? first.name);",
                  "  console.log('All areas:', areas.map(a => a.id + ':' + (a.title?.tr ?? a.title ?? a.name)).join(', '));",
                  "} else {",
                  "  console.log('No areas - venue does not require area selection');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{rezervemToken}}"
              }
            ],
            "url": {
              "raw": "{{rezervemBaseUrl}}/v1/venues/{{slug}}/availability/areas?partySize={{pax}}&date={{date}}&time={{time}}&shift={{shift}}",
              "host": [
