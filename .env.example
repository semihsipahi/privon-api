# ================================================================
# PRIVON API — Environment Variables
# Kopyala: cp .env.example .env  (local)
#          cp .env.example .env.prod  (production — değerleri doldur)
# ================================================================

NODE_ENV=production
PORT=8080

# ── Database ─────────────────────────────────────────────────────
# MongoDB Atlas: Settings > Connect > Connect your application
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/privon?retryWrites=true&w=majority

# ── JWT ──────────────────────────────────────────────────────────
# Üret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET_KEY=<64-char-random-hex>
JWT_EXPIRES_IN=24h
REFRESH_JWT_SECRET_KEY=<64-char-random-hex>
REFRESH_JWT_EXPIRES_IN=30d

# ── SMS (VatanSMS) ───────────────────────────────────────────────
SMSUSER=<vatansms-kullanici-adi>
SMSPASSWORD=<vatansms-sifre>
SMS_HEADER=PRIVON

# ── Email ────────────────────────────────────────────────────────
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USER=apikey
MAIL_PASS=<sendgrid-api-key>
MAIL_FROM=noreply@privon.com

# ── File Storage (MinIO / AWS S3 uyumlu) ─────────────────────────
# Railway / Render: MinIO addon veya external MinIO
MINIO_ENDPOINT=<minio-host>
MINIO_PORT=9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=<minio-access-key>
MINIO_SECRET_KEY=<minio-secret-key>
MINIO_BUCKET=privon
# Dışarıdan erişilebilir public URL (dosya URL'leri için)
MINIO_PUBLIC_URL=https://<minio-host>:9000

# ── Frontend URLs ────────────────────────────────────────────────
BASE_URL_FRONT=https://privon.com
BASE_URL_APP=https://app.privon.com

# ── Rezervem Partner API ─────────────────────────────────────────
# Veri kaynağı anahtarı:
#   db        → mevcut MongoDB Restaurant koleksiyonu (default)
#   rezervem  → Rezervem Partner API (rezervem_venues cache'i)
# İki kaynak HİÇBİR ZAMAN karışmaz — tek anahtar, tek davranış.
RESTAURANT_SOURCE=rezervem

REZERVEM_BASE_URL=https://partnerapi.rezervem.com.tr
REZERVEM_CLIENT_ID=<rezervem-client-id>
REZERVEM_CLIENT_SECRET=<rezervem-client-secret>

# Heuristic eşleşme bulamayan mekanlar bu kategoriye düşer
REZERVEM_FALLBACK_CATEGORY=City Classics

# Local geliştirme / IP whitelist olmadan test: mock dosyalardan yanıt
USE_MOCK_REZERVEM=false

# Test ortamı CDN'inde mekan görselleri yok (NoSuchKey 404). Bu flag açıkken
# adapter, slug-deterministic picsum.photos placeholder URL'leri üretir.
# Prod'da kapatın (false) — gerçek logoUrl/coverPhoto döner.
REZERVEM_USE_PLACEHOLDER_IMAGES=true

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=warn
