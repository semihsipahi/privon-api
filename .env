# === LOCAL ENVIRONMENT (Development) ===
NODE_ENV=development
PORT=8080

# === Database ===
MONGO_URI=mongodb://localhost:27017/privon

# === JWT Authentication ===
JWT_SECRET_KEY=your-local-dev-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=24h
REFRESH_JWT_SECRET_KEY=your-local-dev-refresh-secret-key-change-in-production
REFRESH_JWT_EXPIRES_IN=30d

# === SMS (VatanSMS) ===
SMSUSER=your-sms-username
SMSPASSWORD=your-sms-password
SMS_HEADER=YemApp

# === Email (Nodemailer) ===
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-specific-password
MAIL_FROM=noreply@privon.local

# === File Upload (MinIO for local, AWS S3 for prod) ===
MINIO_ENDPOINT=http://localhost
MINIO_PORT=9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password
MINIO_BUCKET=privon

# === Frontend URLs ===
BASE_URL_FRONT=http://localhost:3000
BASE_URL_APP=http://localhost:8081

# === Logging ===
LOG_LEVEL=debug
# === Apple App Store Review Test Accounts ===
# Bu numaralara SMS gönderilmez; OTP her zaman APPLE_TEST_OTP değerini döner.
APPLE_TEST_PHONES=5000000001,5000000002
APPLE_TEST_OTP=000000

# === Rezervem ===
# Local: db kalsın, mock dev için. Prod'da rezervem'e çevrilecek.
RESTAURANT_SOURCE=db
REZERVEM_BASE_URL=https://partnerapi.rezervem.com.tr
REZERVEM_CLIENT_ID=
REZERVEM_CLIENT_SECRET=
REZERVEM_FALLBACK_CATEGORY=City Classics
USE_MOCK_REZERVEM=false
